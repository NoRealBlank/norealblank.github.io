---
layout: default
---
<div class="post about-page">
  <header class="post-header">
    <h1 class="post-title">
      {% if page.display_name %}
        <span class="name-primary">{{ page.display_name | escape }}</span>
        {% if page.native_name %}
          <span class="name-native" lang="zh">『{{ page.native_name | escape }}』</span>
        {% endif %}
      {% elsif site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if page.contacts %}
      <div class="contact-row" data-email-contacts role="group" aria-label="Email addresses, click to copy">
        <span class="contact-icon" aria-hidden="true"><i class="fa-solid fa-envelope"></i></span>
        <ul class="contact-list">
          {% for contact in page.contacts %}
            <li>
              <button
                type="button"
                class="email-copy"
                data-copy-email="{{ contact.email | escape }}"
                data-contact-label="{{ contact.label | escape }}"
                aria-label="Copy {{ contact.label | escape }} email address: {{ contact.email | escape }}"
                data-toggle="tooltip"
                data-placement="bottom"
                title="Click to copy: {{ contact.email | escape }}"
              >
                {{ contact.label | escape }}
              </button>
            </li>
          {% endfor %}
        </ul>
        <span class="sr-only" data-email-status role="status" aria-live="polite"></span>
        <div class="contact-copy-fallback" data-email-fallback hidden>
          <label>Copy email address <input type="text" readonly data-email-field></label>
        </div>
      </div>
    {% elsif page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article>
    <div class="about-intro{% if page.profile %} has-profile{% endif %}{% if page.profile.align == 'left' %} profile-left{% endif %}">
      {% if page.profile %}
        <div class="profile">
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
            {% endif %}
            {% assign sizes = '(min-width: 576px) 150px, 96px' %}
            {% assign profile_image_alt = page.display_name | default: site.title %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_image_alt
              cache_bust=true
            %}
            {% if page.profile.images.size > 0 %}
              <template id="profile-image-options">
                {% for profile_image in page.profile.images %}
                  {% assign profile_image_path = profile_image | prepend: 'assets/img/' %}
                  {%
                    include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_image_alt
                    cache_bust=true
                  %}
                {% endfor %}
              </template>
              <script>
                {
                  const template = document.getElementById('profile-image-options');
                  const images = template.content.children;
                  const selectedImage = images[Math.floor(Math.random() * images.length)];
                  template.previousElementSibling.replaceWith(selectedImage.cloneNode(true));
                }
              </script>
            {% endif %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
        </div>
      {% endif %}

      <div class="about-bio">{{ content }}</div>
    </div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 class="selected-publications-heading">
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% social_links %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
